{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitScopeDisabled",
    "helpers:pinGitHubActionDigests"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "customManagers": [
    {
      "customType": "regex",
      "description": "appVersion in Chart.yaml is the LibreNMS image tag.",
      "managerFilePatterns": [
        "charts/librenms/Chart.yaml"
      ],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "depNameTemplate": "librenms/librenms",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Updates under charts/ change what the chart deploys and are user-facing. CI actions and tooling stay chore.",
      "matchFileNames": [
        "charts/**"
      ],
      "semanticCommitType": "deps"
    }
  ]
}
